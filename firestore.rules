rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    // A Super Admin (roles/{their email} with role: "admin") can do everything,
    // everywhere — manage the office directory itself, and has Admin rights in
    // every individual office automatically. This is the same "roles" collection
    // used before per-office scoping existed, so your original bootstrap document
    // (the one you created manually in the Firebase console) keeps working.
    function isSuperAdmin() {
      return isSignedIn() && get(/databases/$(database)/documents/roles/$(request.auth.token.email)).data.role == 'admin';
    }

    // An Office Admin (assetTracker/{officeId}/access/{their email} with
    // role: "admin") can edit that ONE office's data, but nothing else — they
    // don't see other offices, and can't manage the office directory or grant
    // other people access.
    function isOfficeAdmin(officeId) {
      return isSignedIn() && get(/databases/$(database)/documents/assetTracker/$(officeId)/access/$(request.auth.token.email)).data.role == 'admin';
    }
    function isOfficeMember(officeId) {
      return isSignedIn() && exists(/databases/$(database)/documents/assetTracker/$(officeId)/access/$(request.auth.token.email));
    }
    // A Team Lead (assetTracker/{officeId}/access/{their email} with role: "teamlead")
    // can submit and track their own Asset Requests for that office, but can't edit
    // office data and can't approve/fulfill even their own requests — see the
    // requests/ rules below for exactly what that role can and can't do.
    function isTeamLead(officeId) {
      return isSignedIn() && get(/databases/$(database)/documents/assetTracker/$(officeId)/access/$(request.auth.token.email)).data.role == 'teamlead';
    }
    function canEditOffice(officeId) {
      return isSuperAdmin() || isOfficeAdmin(officeId);
    }
    function canCreateRequest(officeId) {
      return isSuperAdmin() || isOfficeAdmin(officeId) || isTeamLead(officeId);
    }
    // Only a Super Admin, or someone specifically granted access to THIS
    // office (assetTracker/{officeId}/access/{their email}), can read its
    // data. Being signed in alone isn't enough — a Viewer at Office A can't
    // browse Office B's employees/assets just because they have a login.
    function canViewOffice(officeId) {
      return isSuperAdmin() || isOfficeMember(officeId);
    }

    // Nobody can view OR change anything unless they're signed in through
    // Firebase Authentication (an account you created under Authentication >
    // Users). There is no public read access.
    //
    // Every office's data lives under its own document at
    // assetTracker/{officeId} — completely separate from every other office.
    // Employees, Assignments, Inventory, the Refill Log, and Categories are
    // each their own per-record subcollection (not one shared blob), so two
    // admins editing different records at the same time can never silently
    // overwrite each other's work.
    match /assetTracker/{officeId} {
      allow read: if canViewOffice(officeId);
      allow create, update: if canEditOffice(officeId);
      allow delete: if isSuperAdmin();

      // Delete is Super-Admin-only everywhere in this app — an Office Admin can
      // add/edit records in their office, but only a Super Admin can permanently
      // remove one (single, bulk, or "Delete All").
      // Team Leads can CREATE a brand-new employee record (auto-added the moment
      // they submit an Asset Request for someone not yet on file — saves the
      // Admin from typing it in by hand later) but cannot UPDATE or DELETE an
      // existing one — that stays Admin-only, same as every other master data
      // edit right a Team Lead doesn't get.
      match /employees/{recordId} {
        allow read: if canViewOffice(officeId);
        allow create: if canEditOffice(officeId) || isTeamLead(officeId);
        allow update: if canEditOffice(officeId);
        allow delete: if isSuperAdmin();
      }
      match /assignments/{recordId} {
        allow read: if canViewOffice(officeId);
        allow create, update: if canEditOffice(officeId);
        // Self-service redistribute: a Team Lead may update ONLY a record
        // that's an active custody holding (bulk stock an Admin issued to
        // them) AND where THEY are the recorded custodian — matched by
        // their own sign-in email, set once at bulk-issue time. This is
        // what lets a Team Lead hand one unit from their own custody stock
        // to a real employee straight from their Dashboard, with no other
        // write access to this collection at all. See openRedistributeForm().
        allow update: if isTeamLead(officeId)
          && resource.data.custodyHolder == true
          && resource.data.custodianEmail == request.auth.token.email;
        allow delete: if isSuperAdmin();
      }
      match /inventory/{recordId} {
        allow read: if canViewOffice(officeId);
        allow create, update: if canEditOffice(officeId);
        allow delete: if isSuperAdmin();
      }
      match /refills/{recordId} {
        allow read: if canViewOffice(officeId);
        allow create, update: if canEditOffice(officeId);
        allow delete: if isSuperAdmin();
      }
      // Inter-office Asset Transfers (Sent to / Received from another office) —
      // each office logs its own side independently; there's no cross-office
      // write here, same as every other collection in this app.
      match /transfers/{recordId} {
        allow read: if canViewOffice(officeId);
        allow create, update: if canEditOffice(officeId);
        allow delete: if isSuperAdmin();
      }
      match /categories/{recordId} {
        allow read: if canViewOffice(officeId);
        allow create, update: if canEditOffice(officeId);
        allow delete: if isSuperAdmin();
      }
      match /logs/{logId} {
        allow read: if canViewOffice(officeId);
        // Anyone who can edit this office — OR a Team Lead logging their own
        // actions (submitting a request, etc.) — can WRITE A NEW log entry.
        // The CONTENT of an existing entry can never be changed by anyone
        // (allow update: if false) — that part stays tamper-proof. Deleting
        // an entry outright is Super-Admin-only, same as every other delete
        // in this app — not a general-purpose "edit history" tool.
        allow create: if canEditOffice(officeId) || isTeamLead(officeId);
        allow update: if false;
        allow delete: if isSuperAdmin();
      }

      // Asset Requests: Team Leads submit and track their OWN requests only;
      // Admins/Super Admins see and manage every request in this office. A Team
      // Lead can never write a request into Under Review/Approved/Rejected/
      // Fulfilled — even for their own request — so approving your own request
      // isn't just hidden in the UI, it's rejected here.
      match /requests/{recordId} {
        allow read: if canEditOffice(officeId)
          || (isTeamLead(officeId) && resource.data.requestedBy == request.auth.token.email);
        allow create: if canCreateRequest(officeId)
          && request.resource.data.requestedBy == request.auth.token.email;
        allow update: if canEditOffice(officeId)
          || (isTeamLead(officeId)
              && resource.data.requestedBy == request.auth.token.email
              && request.resource.data.requestedBy == request.auth.token.email
              && request.resource.data.status in ['Draft', 'Submitted', 'Cancelled']);
        // Delete is Super-Admin-only, same as every other collection — an Office
        // Admin can review/approve/reject/cancel a request, but not erase it.
        allow delete: if isSuperAdmin();
      }
      // Sequential, server-safe numbering for Request IDs (AST-REQ-2026-00001, ...) —
      // a tiny counter doc incremented inside a transaction, separate from the
      // office meta doc so Team Leads (who can't write that doc) can still create
      // requests and get a real number.
      match /counters/{counterId} {
        allow read: if canViewOffice(officeId);
        allow write: if canCreateRequest(officeId);
      }

      // Per-office access grants (assetTracker/{officeId}/access/{email} ->
      // {role: "admin"|"viewer"}). Only a Super Admin can grant, change, or
      // revoke access to a specific office — an Office Admin manages that
      // office's DATA, not who else can get in.
      match /access/{email} {
        allow read: if isSignedIn();
        allow write: if isSuperAdmin();
      }
    }

    // Lets the app find "which offices does this person have access to"
    // via a collection-group query across every office's access subcollection.
    match /{path=**}/access/{email} {
      allow read: if isSignedIn();
    }

    // The office directory itself (assetTracker/_offices, the list of every
    // office's id/name/city). Only a Super Admin can create, rename, or
    // delete offices; anyone signed in can read the list.
    match /assetTracker/_offices {
      allow read: if isSignedIn();
      allow write: if isSuperAdmin();
    }

    // Global role assignments — one document per email (roles/someone@company.com
    // with a field role: "admin"). This is the Super Admin list. Anyone signed
    // in can read it (so the app can check its own role); only an existing
    // Super Admin can grant, change, or revoke it.
    match /roles/{email} {
      allow read: if isSignedIn();
      allow write: if isSuperAdmin();
    }

    // Login Activity — one record per sign-in (device/browser + approximate
    // location), written by the app right after a successful sign-in. This
    // happens BEFORE an office is chosen, so it lives at the top level, not
    // under assetTracker/{officeId}. Anyone signed in can write ONE record —
    // their own — for their own login; only a Super Admin can read the log.
    // Append-only, same as the per-office Activity Log: nobody can edit or
    // delete an entry once it exists, so it stays a trustworthy record.
    match /loginLogs/{recordId} {
      allow read: if isSuperAdmin();
      allow create: if isSignedIn() && request.resource.data.email == request.auth.token.email;
      allow update, delete: if false;
    }
  }
}
