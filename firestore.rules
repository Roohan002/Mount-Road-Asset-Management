rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    // A Super Admin (roles/{their email} with role: "admin") can do everything,
    // everywhere — manage the office directory itself, and has Admin rights in
    // every individual office automatically. This is the same "roles" collection
    // used before per-office scoping existed, so your original bootstrap document
    // (the one you created manually in the Firebase console) keeps working.
    function isSuperAdmin() {
      return isSignedIn() && get(/databases/$(database)/documents/roles/$(request.auth.token.email)).data.role == 'admin';
    }

    // An Office Admin (assetTracker/{officeId}/access/{their email} with
    // role: "admin") can edit that ONE office's data, but nothing else — they
    // don't see other offices, and can't manage the office directory or grant
    // other people access.
    function isOfficeAdmin(officeId) {
      return isSignedIn() && get(/databases/$(database)/documents/assetTracker/$(officeId)/access/$(request.auth.token.email)).data.role == 'admin';
    }
    function isOfficeMember(officeId) {
      return isSignedIn() && exists(/databases/$(database)/documents/assetTracker/$(officeId)/access/$(request.auth.token.email));
    }
    function canEditOffice(officeId) {
      return isSuperAdmin() || isOfficeAdmin(officeId);
    }
    // Anyone signed in can currently READ any office's data (needed for the
    // simple "everyone with a login can view" setup). If you want Viewers
    // restricted to only the offices they've been granted access to as well,
    // swap the allow-read lines below to: isSuperAdmin() || isOfficeMember(officeId)
    function canViewOffice(officeId) {
      return isSignedIn();
    }

    // Nobody can view OR change anything unless they're signed in through
    // Firebase Authentication (an account you created under Authentication >
    // Users). There is no public read access.
    //
    // Every office's data lives under its own document at
    // assetTracker/{officeId} — completely separate from every other office.
    // Employees, Assignments, Inventory, the Refill Log, and Categories are
    // each their own per-record subcollection (not one shared blob), so two
    // admins editing different records at the same time can never silently
    // overwrite each other's work.
    match /assetTracker/{officeId} {
      allow read: if canViewOffice(officeId);
      allow write: if canEditOffice(officeId);

      match /employees/{recordId} {
        allow read: if canViewOffice(officeId);
        allow write: if canEditOffice(officeId);
      }
      match /assignments/{recordId} {
        allow read: if canViewOffice(officeId);
        allow write: if canEditOffice(officeId);
      }
      match /inventory/{recordId} {
        allow read: if canViewOffice(officeId);
        allow write: if canEditOffice(officeId);
      }
      match /refills/{recordId} {
        allow read: if canViewOffice(officeId);
        allow write: if canEditOffice(officeId);
      }
      match /categories/{recordId} {
        allow read: if canViewOffice(officeId);
        allow write: if canEditOffice(officeId);
      }
      match /logs/{logId} {
        allow read: if canViewOffice(officeId);
        // Append-only: anyone who can edit this office can WRITE A NEW log entry,
        // but nobody — not even an Admin — can modify or delete one that already
        // exists. That's what makes the audit trail actually trustworthy.
        allow create: if canEditOffice(officeId);
        allow update, delete: if false;
      }

      // Per-office access grants (assetTracker/{officeId}/access/{email} ->
      // {role: "admin"|"viewer"}). Only a Super Admin can grant, change, or
      // revoke access to a specific office — an Office Admin manages that
      // office's DATA, not who else can get in.
      match /access/{email} {
        allow read: if isSignedIn();
        allow write: if isSuperAdmin();
      }
    }

    // Lets the app find "which offices does this person have access to"
    // via a collection-group query across every office's access subcollection.
    match /{path=**}/access/{email} {
      allow read: if isSignedIn();
    }

    // The office directory itself (assetTracker/_offices, the list of every
    // office's id/name/city). Only a Super Admin can create, rename, or
    // delete offices; anyone signed in can read the list.
    match /assetTracker/_offices {
      allow read: if isSignedIn();
      allow write: if isSuperAdmin();
    }

    // Global role assignments — one document per email (roles/someone@company.com
    // with a field role: "admin"). This is the Super Admin list. Anyone signed
    // in can read it (so the app can check its own role); only an existing
    // Super Admin can grant, change, or revoke it.
    match /roles/{email} {
      allow read: if isSignedIn();
      allow write: if isSuperAdmin();
    }
  }
}
