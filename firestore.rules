rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Nobody can view OR change the data unless they're signed in through
    // Firebase Authentication (i.e. an account you created yourself under
    // Authentication > Users). There is no public read access.
    match /assetTracker/{docId} {
      allow read, write: if request.auth != null;
    }
  }
}
