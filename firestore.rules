rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Everyone (including people who are not signed in) can VIEW the data.
    // Only someone signed in through Firebase Authentication (i.e. an admin
    // account you created under Authentication > Users) can WRITE to it.
    match /assetTracker/{docId} {
      allow read: if true;
      allow write: if request.auth != null;
    }
  }
}
